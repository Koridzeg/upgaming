# Copy this file to .env and fill in the values. .env is git-ignored: never commit real keys.

# Local development database (matches docker-compose.yml). In production this is the Neon URL.
DATABASE_URL=postgresql://investigator:investigator@localhost:5433/investigator

# LLM providers. Either key is enough; with both, the second is the fallback.
# Free keys: https://console.groq.com/keys and https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional overrides (see `python -m investigator.llm --models` for what your keys can use)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER_ORDER=["groq","gemini"]

LOG_LEVEL=INFO
